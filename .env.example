# Your AIOS — copy this file to .env and fill it. .env never leaves this folder and never goes in git.
# Type or paste the values here yourself. Never paste a key into the chat with Claude.

# Supabase dashboard > Project Settings > General > Project ID
SUPABASE_PROJECT_REF=
# Supabase dashboard > Project Settings > Data API > Project URL  (looks like https://<ref>.supabase.co)
SUPABASE_URL=
# Supabase dashboard > Project Settings > API Keys > Publishable key (starts with sb_publishable_)
SUPABASE_PUBLISHABLE_KEY=
# Supabase dashboard > Project Settings > API Keys > Secret key (starts with sb_secret_). Full write access: guard it.
SUPABASE_SECRET_KEY=
# supabase.com/dashboard/account/tokens > Generate new token, scoped to this project only.
# Permissions: everything Read, plus Database and Migrations Read-write. Used for migrations and checks.
SUPABASE_ACCESS_TOKEN=
# Optional, a second token with only Network restrictions Read-write (execution/allow_my_ip.py).
SUPABASE_NETWORK_TOKEN=
